# Copy to .env and fill in values from web.dhan.co → My Profile → Access DhanHQ APIs
# Used for historical download + live LTP for paper trading.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Optional: DevPortal sandbox (API shape tests only — NOT paper trading)
# https://developer.dhanhq.co/sandbox
DHAN_SANDBOX_CLIENT_ID=
DHAN_SANDBOX_ACCESS_TOKEN=

# live = api.dhan.co (default). sandbox = sandbox.dhan.co for order API dry-runs only.
DHAN_MODE=live

# Local / free Render testing: SQLite is fine.
# Render Free disk is ephemeral — DB/checkpoints reset on sleep or redeploy.
# For history that survives restarts, use free Supabase Postgres + pip install -e ".[postgres]":
# DATABASE_URL=postgresql+psycopg://postgres:...@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./data/algo.db

# Paper prices: auto = Dhan WebSocket + REST then Yahoo. Options: public | dhan | dhan-ws | auto
PAPER_PRICE_SOURCE=auto

# Token also stored in data/dhan_token.json after Settings → Save token.
# PARTNER (Developer Portal) tokens cannot RenewToken — paste daily.
# SELF tokens from web.dhan.co can auto-renew while still valid.
