# Copy to .env and fill in values from web.dhan.co → My Profile → Access DhanHQ APIs
# Used for historical download + live LTP for paper trading.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Optional: DevPortal sandbox (API shape tests only — NOT paper trading)
# https://developer.dhanhq.co/sandbox
DHAN_SANDBOX_CLIENT_ID=
DHAN_SANDBOX_ACCESS_TOKEN=

# live = api.dhan.co (default). sandbox = sandbox.dhan.co for order API dry-runs only.
DHAN_MODE=live

# Shared DB (recommended): free Supabase Postgres — same URL on laptop + Render.
# Project Settings → Database → Connection string → URI (direct, port 5432).
# Example:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres?sslmode=require
# Local-only fallback:
DATABASE_URL=sqlite:///./data/algo.db

# Paper prices: Dhan WebSocket + REST only (no Yahoo). Options: dhan-ws | dhan
PAPER_PRICE_SOURCE=dhan-ws

# Token also stored in data/dhan_token.json after Settings → Save token.
# PARTNER (Developer Portal) tokens cannot RenewToken — paste daily.
# SELF tokens from web.dhan.co can auto-renew while still valid.

# Cron auth (same value in Render env + GitHub Actions secret CRON_SECRET)
CRON_SECRET=

# Daily pre-market / post-market email digests
REPORT_EMAIL_TO=dharmikvalani57@gmail.com
# Preferred: Brevo transactional API (https://app.brevo.com)
BREVO_API_KEY=
EMAIL_USER=hello@mail.weupsell.com
SMTP_FROM=hello@mail.weupsell.com
# EMAIL_HOST is only used for SMTP fallback (not needed with BREVO_API_KEY)
# EMAIL_HOST=smtp-relay.brevo.com
# SMTP fallback (optional):
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
